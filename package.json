{
  "name": "localtill-pos",
  "private": true,
  "description": "LocalTill - Sistema de Ponto de Venda (PDV) Offline-First Desktop e Web",
  "author": "Jhonatan Ecard <jhonatanecard@gmail.com>",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"cd server && npm run dev\" \"vite --port 5174\"",
    "dev:web": "vite --port 5174",
    "test": "playwright test --reporter=html",
    "test:unit": "vitest run",
    "build": "npm run build:server && tsc && tsc -p electron/tsconfig.json && vite build && electron-builder",
    "build:web": "vite build",
    "build:server": "cd server && npm install && npm run build",
    "electron:build": "npm run build:server && tsc -p electron/tsconfig.json && electron-builder",
    "electron:build:win": "npm run build:server && tsc && tsc -p electron/tsconfig.json && vite build && electron-builder --win",
    "electron:build:mac": "npm run build:server && tsc && tsc -p electron/tsconfig.json && vite build && electron-builder --mac",
    "electron:build:all": "npm run build:server && tsc && tsc -p electron/tsconfig.json && vite build && electron-builder -mw",
    "electron:dev": "concurrently -k \"cross-env BROWSER=none npm run dev\" \"wait-on tcp:5173 && tsc -p electron/tsconfig.json && electron .\"",
    "compile:electron": "tsc -p electron/tsconfig.json",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@rollup/rollup-linux-x64-gnu": "^4.62.5",
    "@supabase/supabase-js": "^2.79.0",
    "@tanstack/react-query": "^5.83.0",
    "@types/uuid": "^10.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-barcode": "^1.6.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^3.4.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0",
    "vaul": "^0.9.9",
    "wait-on": "^9.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.38.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/wait-on": "^5.3.4",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "electron-packager": "^17.1.2",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lovable-tagger": "^1.1.11",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.localtill.pos",
    "productName": "LocalTill POS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server/dist",
        "to": "server/dist"
      },
      {
        "from": "server/package.json",
        "to": "server/package.json"
      },
      {
        "from": "server/node_modules",
        "to": "server/node_modules"
      }
    ],
    "win": {
      "target": [
        "zip",
        "dir"
      ],
      "artifactName": "${productName}-${version}-win.${ext}",
      "icon": "public/icon.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "zip",
        "dir"
      ],
      "artifactName": "${productName}-${version}-mac.${ext}",
      "icon": "public/icon.png",
      "category": "public.app-category.business",
      "identity": null
    },
    "extraFiles": [
      {
        "from": "imagens",
        "to": "imagens"
      }
    ]
  }
}
